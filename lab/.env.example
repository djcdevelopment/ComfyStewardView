# Copy this file to .env in the lab directory on the deployment workstation and fill it in.
# Deploy-World.ps1 transfers it to /home/derek/steward-world/.env on AM4 with mode 600.
# It may instead be provisioned directly at that remote path. Never commit the real values.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_FEEDBACK_WEBHOOK_URL=
DISCORD_OWNER_USER_ID=

# The Discord application redirect URI must be exactly:
# https://am4.tail8e749c.ts.net/world/api/auth/discord/callback
STEWARD_PUBLIC_URL=https://am4.tail8e749c.ts.net/world/
