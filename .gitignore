### workspace artifacts ###
.tools/
# ignore exported world data that we will keep locally
*.db
*.fwl*

# Daemon runtime logs — re-generated on every restart
viewer/logs/*.log
viewer/logs/*.err

# Batch analytics outputs generated from real world saves
viewer/target/*.duckdb
viewer/target/*.duckdb.wal
viewer/target/rendered-*/
viewer/target/generation-*.log
/steward-config.json

# White paper build output; docs/comfy-integration/WHITEPAPER.html is the source
docs/comfy-integration/whitepaper.built.html
